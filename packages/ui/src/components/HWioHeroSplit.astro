---
/** Two-column hero: copy + actions left, media slot right (or reversed). Title may be passed as a slot for inline markup. */
import type { HWioCta } from '../types';
import HWioButton from './HWioButton.astro';
import HWioIcon from './HWioIcon.astro';
interface Props { id?: string; eyebrow?: string; title: string; lead?: string; actions?: HWioCta[]; checklist?: string[]; reverse?: boolean; class?: string }
const { id, eyebrow, title, lead, actions = [], checklist = [], reverse = false, class: className = '' } = Astro.props;
const VARIANT = { primary: 'primary', secondary: 'secondary', ghost: 'ghost' } as const;
---
<section id={id} class:list={['bg-base-100 text-base-content', className]}>
  <div class:list={['container grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24', reverse ? 'lg:[&>*:first-child]:order-2' : '']}>
    <div>
      {eyebrow && <p class="hwio-eyebrow mb-4">{eyebrow}</p>}
      <h1><slot name="title">{title}</slot></h1>
      {lead && <p class="hwio-lead mt-6 max-w-xl">{lead}</p>}
      {actions.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-4">
          {actions.map((a, i) => <HWioButton href={a.href} external={a.external} variant={VARIANT[a.variant ?? (i === 0 ? 'primary' : 'secondary')]} size="lg" arrow={i === 0} track={a.track}>{a.label}</HWioButton>)}
        </div>
      )}
      {checklist.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {checklist.map((c) => <li class="inline-flex items-center gap-2"><HWioIcon name="check" size="sm" class="text-accent" />{c}</li>)}
        </ul>
      )}
      <slot name="extra" />
    </div>
    <div class="relative"><slot name="media" /></div>
  </div>
</section>
