---
/**
 * Sticky site header: logo slot, primary nav (flat links, or mega items whose `mega:<key>` slot opens as a
 * full-width panel under the bar), CTAs, language switcher, theme toggle, and a DaisyUI drawer for small
 * screens, where a mega item lists its `children` as a collapsible group instead.
 */
import type { HWioCta, HWioLinkItem } from '../types';
import HWioButton from './HWioButton.astro';
import HWioIcon from './HWioIcon.astro';
import HWioLanguageSwitcher from './HWioLanguageSwitcher.astro';
import HWioThemeToggle from './HWioThemeToggle.astro';

interface NavItem extends HWioLinkItem {
  /** Key of the `mega:<key>` slot; the item becomes a button that opens the panel (hover, click, keyboard). */
  mega?: string;
  /** Links listed under the item in the drawer (the panel is desktop-only). */
  children?: HWioLinkItem[];
}
interface Props {
  nav: NavItem[];
  ctas?: HWioCta[];
  languages?: { code: string; label: string; href: string; current?: boolean }[];
  showThemeToggle?: boolean;
  scrollspy?: boolean;
  labels: { nav: string; menu: string; close: string; theme?: string; languages?: string };
  /** Viewport from which the inline nav and CTAs replace the drawer (default lg; xl for long navs). */
  desktopFrom?: 'lg' | 'xl';
  id?: string;
  class?: string;
}
const { nav, ctas = [], languages = [], showThemeToggle = true, scrollspy = false, labels, desktopFrom = 'lg', id = 'hwio-nav-drawer', class: className = '' } = Astro.props;
const BREAK = {
  lg: { nav: 'hidden flex-1 justify-center lg:flex', ctas: 'hidden items-center gap-2 lg:flex', drawer: 'drawer drawer-end w-auto lg:hidden', panels: 'hidden lg:block' },
  xl: { nav: 'hidden flex-1 justify-center xl:flex', ctas: 'hidden items-center gap-2 xl:flex', drawer: 'drawer drawer-end w-auto xl:hidden', panels: 'hidden xl:block' },
} as const;
const bp = BREAK[desktopFrom];
const CTA_VARIANT = { primary: 'primary', secondary: 'secondary', ghost: 'ghost' } as const;
const megaItems = nav.filter((item) => item.mega);
const linkAttrs = (item: HWioLinkItem) => (item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---
<header class:list={['sticky top-0 z-50 border-b border-base-300 bg-base-100/90 backdrop-blur supports-[backdrop-filter]:bg-base-100/80', className]} data-hwio-font-exempt>
  <div class="container flex h-16 items-center gap-4 lg:h-[72px]">
    <div class="shrink-0">
      <slot name="logo" />
    </div>

    <nav class={bp.nav} aria-label={labels.nav} data-hwio-scrollspy={scrollspy ? 'true' : undefined}>
      <ul class="menu menu-horizontal flex-nowrap gap-0 px-0 whitespace-nowrap">
        {nav.map((item) => (
          <li>
            {item.mega ? (
              <button type="button" class="px-3 text-[15px] font-medium text-base-content/80 hover:text-accent" data-hwio-mega-trigger={item.mega} aria-expanded="false" aria-haspopup="true" aria-controls={`${id}-mega-${item.mega}`}>
                {item.label}
                <HWioIcon name="chevron-down" size="sm" class="opacity-50 transition-transform duration-200" />
              </button>
            ) : (
              <a href={item.href} class="px-3 text-[15px] font-medium text-base-content/80 hover:text-accent" aria-current={item.current ? 'page' : undefined} data-track={item.track?.id} data-track-location={item.track?.location ?? 'header'}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {showThemeToggle && <HWioThemeToggle label={labels.theme ?? 'Theme'} />}
      {languages.length > 1 && <HWioLanguageSwitcher items={languages} label={labels.languages ?? 'Language'} />}
      <div class={bp.ctas}>
        {ctas.map((cta) => (
          <HWioButton href={cta.href} external={cta.external} variant={CTA_VARIANT[cta.variant ?? 'primary']} size="sm" track={cta.track ?? { id: 'header-cta', location: 'header' }} class={cta.icon ? '2xl:px-4 px-2.5' : ''} aria-label={cta.icon ? cta.label : undefined} title={cta.icon ? cta.label : undefined}>
            {cta.icon && <HWioIcon name={cta.icon as 'bag'} size="sm" />}
            {cta.icon ? <span class="hidden 2xl:inline">{cta.label}</span> : cta.label}
          </HWioButton>
        ))}
      </div>
      <div class={bp.drawer}>
        <input id={id} type="checkbox" class="drawer-toggle" />
        <div class="drawer-content">
          <label for={id} class="btn btn-ghost btn-square drawer-button" aria-label={labels.menu} aria-controls={`${id}-panel`} aria-expanded="false" tabindex="0" role="button">
            <HWioIcon name="menu" size="lg" />
          </label>
        </div>
        <div class="drawer-side z-[60]">
          <label for={id} aria-label={labels.close} class="drawer-overlay"></label>
          <div id={`${id}-panel`} class="menu min-h-full w-80 max-w-[85vw] gap-2 bg-base-100 p-6 text-base-content">
            <div class="flex justify-end">
              <label for={id} class="btn btn-ghost btn-square btn-sm" aria-label={labels.close} tabindex="0" role="button"><HWioIcon name="close" /></label>
            </div>
            <ul class="menu w-full text-base">
              {nav.map((item) => (
                <li>
                  {item.children?.length ? (
                    <details>
                      <summary>{item.label}</summary>
                      <ul>
                        {item.children.map((child) => (
                          <li><a href={child.href} {...linkAttrs(child)} data-track={child.track?.id} data-track-location="mobile-menu">{child.label}{child.external && <HWioIcon name="external" size="sm" class="opacity-50" />}</a></li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a href={item.href} {...linkAttrs(item)} aria-current={item.current ? 'page' : undefined} data-track={item.track?.id} data-track-location="mobile-menu">{item.label}</a>
                  )}
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-col gap-2">
              {ctas.map((cta) => (
                <HWioButton href={cta.href} external={cta.external} variant={CTA_VARIANT[cta.variant ?? 'primary']} track={{ id: cta.track?.id ?? 'header-cta', location: 'mobile-menu' }}>{cta.label}</HWioButton>
              ))}
            </div>
            {languages.length > 1 && <div class="mt-4"><HWioLanguageSwitcher items={languages} label={labels.languages ?? 'Language'} variant="pills" /></div>}
          </div>
        </div>
      </div>
    </div>
  </div>
  {megaItems.length > 0 && (
    <div class={bp.panels}>
      {megaItems.map((item) => (
        <div id={`${id}-mega-${item.mega}`} class="absolute inset-x-0 top-full border-t border-base-300 bg-base-100 shadow-xl" data-hwio-mega-panel={item.mega} hidden>
          <div class="container py-8"><slot name={`mega:${item.mega}`} /></div>
        </div>
      ))}
    </div>
  )}
</header>
<script>
  import { hwioNavRuntime } from '@hubpav/hwio-web-runtime/nav';
  hwioNavRuntime();
</script>
