{
  "$comment": "Source of truth for HARDWARIO web brand values. Edit here, run `npm run build`; every generated artifact (tokens.json, vars.css, docusaurus.css, the DaisyUI theme files in @hubpav/hwio-ui) is committed so a change shows its full downstream diff. Colours are hex; theme roles reference palette keys. Owner rulings 2026-09-05 (DESIGN-SYSTEM.md in website-admin): R1 navy primary + red accent, R2 dark kept (Zola neutral palette), R3 font-display block + gate, R7 enerooo palette preserved.",
  "palette": {
    "white": "#ffffff",
    "sky": "#F1FAFF",
    "gray-100": "#f3f4f6",
    "gray-200": "#e5e7eb",
    "gray-300": "#d1d5db",
    "gray-500": "#6b6a6a",
    "muted": "#5c5f70",
    "ink": "#252532",
    "red": "#e30427",
    "rose": "#f43f5e",
    "blue": "#016ad4",
    "blue-light": "#009cfa",
    "blue-dark": "#06367a",
    "night-100": "#0f0f14",
    "night-200": "#1a1a22",
    "night-300": "#23232f",
    "night-content": "#e7e7ee",
    "green": "#15803d",
    "amber": "#b45309",
    "error": "#dc2626",
    "forestry": "#2B7036",
    "forestry-light": "#5aa864",
    "er3o-green": "#01CC9B",
    "er3o-teal": "#14A0C0",
    "er3o-teal-text": "#0C6678",
    "er3o-heading": "#19768B",
    "er3o-ink": "#061920",
    "er3o-text": "#333333",
    "er3o-gray-50": "#f9fafb"
  },
  "shape": {
    "hwio": {
      "radius-selector": "2rem",
      "radius-field": "0.5rem",
      "radius-box": "1rem",
      "size-selector": "0.25rem",
      "size-field": "0.28125rem",
      "border": "1px",
      "depth": "0",
      "noise": "0"
    },
    "er3o": {
      "radius-selector": "2rem",
      "radius-field": "2rem",
      "radius-box": "1.5rem",
      "size-selector": "0.25rem",
      "size-field": "0.28125rem",
      "border": "1px",
      "depth": "0",
      "noise": "0"
    }
  },
  "themes": {
    "hwio": {
      "scheme": "light",
      "default": true,
      "prefersdark": false,
      "font": "inter",
      "shape": "hwio",
      "roles": {
        "base-100": "white",
        "base-200": "sky",
        "base-300": "gray-100",
        "base-content": "ink",
        "primary": "blue-dark",
        "primary-content": "white",
        "secondary": "blue",
        "secondary-content": "white",
        "accent": "red",
        "accent-content": "white",
        "neutral": "ink",
        "neutral-content": "gray-100",
        "info": "blue-light",
        "info-content": "blue-dark",
        "success": "green",
        "success-content": "white",
        "warning": "amber",
        "warning-content": "white",
        "error": "error",
        "error-content": "white"
      }
    },
    "hwio-dark": {
      "extends": "hwio",
      "scheme": "dark",
      "default": false,
      "prefersdark": true,
      "roles": {
        "base-100": "night-100",
        "base-200": "night-200",
        "base-300": "night-300",
        "base-content": "night-content",
        "accent": "rose",
        "accent-content": "night-100",
        "neutral": "night-300",
        "neutral-content": "night-content"
      }
    },
    "hwio-forestry": {
      "extends": "hwio",
      "roles": {
        "primary": "forestry",
        "accent": "forestry"
      }
    },
    "hwio-forestry-dark": {
      "extends": "hwio-dark",
      "roles": {
        "primary": "forestry",
        "accent": "forestry-light",
        "accent-content": "night-100"
      }
    },
    "er3o": {
      "scheme": "light",
      "default": false,
      "prefersdark": false,
      "font": "poppins",
      "shape": "er3o",
      "roles": {
        "base-100": "white",
        "base-200": "er3o-gray-50",
        "base-300": "gray-100",
        "base-content": "er3o-text",
        "primary": "er3o-teal",
        "primary-content": "white",
        "secondary": "er3o-green",
        "secondary-content": "er3o-ink",
        "accent": "er3o-teal-text",
        "accent-content": "white",
        "neutral": "ink",
        "neutral-content": "white",
        "info": "er3o-heading",
        "info-content": "white",
        "success": "green",
        "success-content": "white",
        "warning": "amber",
        "warning-content": "white",
        "error": "error",
        "error-content": "white"
      },
      "extras": {
        "--er3o-gradient-from": "#01CC9B",
        "--er3o-gradient-to": "#14A0C0"
      }
    }
  },
  "layout": {
    "hub": {
      "container": "1275px",
      "pad": "27px"
    },
    "landing": {
      "container": "1640px",
      "pad": "27px"
    }
  },
