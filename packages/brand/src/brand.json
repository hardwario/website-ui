            "fontWeight": 700,
            "lineHeight": 1.3,
            "letterSpacing": "-0.005em"
          },
          "lead": {
            "selector": ".hwio-lead",
            "fontSize": "1.1875rem",
            "fontWeight": 400,
            "lineHeight": 1.55,
            "letterSpacing": "0"
          },
          "body": {
            "element": "body",
            "fontSize": "1.0625rem",
            "fontWeight": 400,
            "lineHeight": 1.6,
            "letterSpacing": "0"
          },
          "caption": {
            "selector": ".hwio-caption",
            "fontSize": "0.875rem",
            "fontWeight": 400,
            "lineHeight": 1.4,
            "letterSpacing": "0"
          },
          "kicker": {
            "selector": ".hwio-kicker",
            "fontSize": "0.875rem",
            "fontWeight": 600,
            "lineHeight": 1.4,
            "letterSpacing": "0",
            "textTransform": "none"
          },
          "chip": {
