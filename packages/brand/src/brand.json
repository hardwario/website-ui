            "fontSize": "0.875rem",
            "fontWeight": 500,
            "letterSpacing": "0",
            "textTransform": "none"
          },
          "figure": {
            "selector": ".hwio-figure",
            "fontSize": "2.5rem",
            "responsive": {
              "base": "2.25rem"
            },
            "from": "lg",
            "fontWeight": 700,
            "lineHeight": 1,
            "letterSpacing": "-0.03em"
          },
          "button": {
            "selector": ".btn",
            "fontSize": "0.9375rem",
            "fontWeight": 600,
            "lineHeight": 1,
            "letterSpacing": "0"
          }
        },
        "weights": {
          "nav": 500,
          "label": 600,
          "strong": 600,
          "footerTitle": 500
