  "rhythm": {
    "$comment": "Spacing rhythm as implemented in styles.css: Tailwind --spacing is 4px; .hwio-section is 20/28 units, compact 10/12 units; controls are 48px tall; card padding 32px.",
    "unit": "8px",
    "section": {
      "base": "80px",
      "lg": "112px"
    },
    "sectionCompact": {
      "base": "40px",
      "lg": "48px"
    },
    "control": "48px",
    "cardPadding": "32px"
  },
  "motion": {
    "$comment": "Chapter 10, Motion and video (still a proposal in revision 3): calm ease-out curves, 200-400 ms in interfaces, nothing bounces or spins. Generated into --hwio-motion-* on the HARDWARIO themes.",
    "easing": "ease-out",
    "fast": "200ms",
    "base": "300ms",
    "slow": "400ms"
  },
  "icons": {
    "$comment": "Chapter 05, Icons: Lucide only, outline on a 24 px grid with a 2 px stroke, one colour, Navy; White on dark grounds; 16, 24 or 32 px on screen; they label, never decorate. HWioIcon still draws Heroicons outlines: swapping the glyphs changes www.enerooo.cz too, so it follows with PLAN 4.4 or 4.7.",
    "set": "lucide",
    "color": "navy",
    "colorOnDark": "white",
    "stroke": "2px",
    "grid": "24px",
    "sizes": [
      "16px",
      "24px",
      "32px"
    ]
  },
  "charts": {
    "$comment": "Chapter 06, Charts, and D14: series Blue, Sky and Gray in this order, three at most; the one highlighted value in bold Navy; a forecast in Mist; Red means a failure and nothing else. The guidelines define no chart colours for dark grounds (Navy is 1.6:1 on the dark ground): an open change request.",
    "series": [
      "blue",
      "sky",
      "gray"
    ],
    "highlight": "navy",
    "forecast": "mist",
    "failure": "red"
  },
