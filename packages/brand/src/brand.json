  "breakpoints": {
    "$comment": "Tailwind 4 defaults, named as in its responsive variants; the web layer in DESIGN-SYSTEM.md sets which sizes change where.",
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem",
    "2xl": "96rem"
  },
  "layout": {
    "$comment": "Container presets, chosen per theme. grid: the guidelines' web grid (chapter 05: twelve columns, 1 280 px wide, 24 px gutters), so the container is the 1 280 px content box plus a 24 px margin each side. hub: www's pre-guideline width, kept for er3o. landing: unused since 2026-10-13.",
    "grid": {
      "container": "1328px",
      "pad": "24px",
      "width": "1280px",
      "columns": 12,
      "gutter": "24px"
    },
    "hub": {
      "container": "1275px",
      "pad": "27px"
    },
    "landing": {
      "container": "1640px",
      "pad": "27px"
    }
  },
  "typography": {
    "$comment": "Type presets, chosen per theme (`typography` key) and generated into --hwio-type-<role>-{size,weight,leading,tracking,case} custom properties in each theme file, with the responsive steps as media queries at the breakpoints above. styles.css reads only these variables. A test (packages/brand/test/design-md.test.mjs) checks that styles.css uses every role and that the generated theme files carry the values.",
    "presets": {
      "hwio": {
        "$comment": "Brand Guidelines chapter 04, web column: H1 60-72 px Bold, H2 40-48 px Semibold, H3 28-32 px Semibold, kicker 12-14 px Bold caps in Red (0.07 em), body 16 px Regular at 1.6, caption 12-14 px Regular in Gray. Minimum line heights 1.2 display (28 pt, about 37 px, and up), 1.3 titles, 1.4 text (D12); display tracking -1 to -2 %; Regular, Semibold (web H2 and H3 only) and Bold, no Medium (D22). The steps below lg are the web layer (DESIGN-SYSTEM.md): phones and tablets cannot carry a 60 px H1. fontSize is the value from `from`; responsive lists the smaller steps; lineHeightSteps raise or lower the line height where a role crosses 28 pt (37.3 px), since the role follows the size (chapter 04).",
        "roles": {
          "display": {
            "element": "h1",
            "fontSize": "4.5rem",
            "responsive": {
              "base": "2.5rem",
              "md": "3rem",
              "lg": "3.75rem"
            },
            "from": "xl",
            "fontWeight": 700,
            "lineHeight": 1.2,
            "letterSpacing": "-0.02em"
          },
          "heading": {
            "element": "h2",
            "fontSize": "3rem",
            "responsive": {
              "base": "2rem",
              "lg": "2.5rem"
            },
            "from": "xl",
            "fontWeight": 600,
            "lineHeight": 1.3,
            "lineHeightSteps": {
              "lg": 1.2
            },
            "letterSpacing": "-0.015em"
          },
          "subheading": {
            "element": "h3",
            "fontSize": "2rem",
            "responsive": {
              "base": "1.5rem",
              "lg": "1.75rem"
            },
            "from": "xl",
            "fontWeight": 600,
            "lineHeight": 1.3,
            "letterSpacing": "-0.01em"
          },
          "title": {
            "element": "h4",
            "fontSize": "1.25rem",
            "fontWeight": 700,
            "lineHeight": 1.3,
            "letterSpacing": "0"
          },
          "lead": {
            "selector": ".hwio-lead",
            "fontSize": "1.1875rem",
            "fontWeight": 400,
            "lineHeight": 1.55,
            "letterSpacing": "0"
          },
          "body": {
            "element": "body",
            "fontSize": "1rem",
            "fontWeight": 400,
            "lineHeight": 1.6,
            "letterSpacing": "0"
          },
          "caption": {
            "selector": ".hwio-caption",
            "fontSize": "0.8125rem",
            "fontWeight": 400,
            "lineHeight": 1.4,
            "letterSpacing": "0"
          },
          "kicker": {
            "selector": ".hwio-kicker",
            "fontSize": "0.8125rem",
            "fontWeight": 700,
            "lineHeight": 1.4,
            "letterSpacing": "0.07em",
            "textTransform": "uppercase"
          },
          "chip": {
            "selector": ".hwio-chip",
            "fontSize": "0.75rem",
            "fontWeight": 700,
            "lineHeight": 1.4,
            "letterSpacing": "0.07em",
            "textTransform": "uppercase"
          },
          "figure": {
            "selector": ".hwio-figure",
            "fontSize": "2.5rem",
            "fontWeight": 700,
            "lineHeight": 1.2,
            "letterSpacing": "-0.02em"
          },
          "button": {
            "selector": ".btn",
            "fontSize": "0.9375rem",
            "fontWeight": 700,
            "lineHeight": 1,
            "letterSpacing": "0"
          }
        },
        "weights": {
          "nav": 400,
          "label": 700,
          "strong": 700,
          "footerTitle": 700
        },
        "vars": {
          "--hwio-choice-title-size": "var(--hwio-type-subheading-size)",
          "--hwio-choice-title-leading": "var(--hwio-type-subheading-leading)",
          "--hwio-choice-title-tracking": "var(--hwio-type-subheading-tracking)"
        }
      },
      "er3o": {
        "$comment": "Direction A (R9, 2026-09-05) as shipped until 0.7.11, kept for er3o: ENEROOO has its own brand manual (PLAN 4.7) and its look stays unchanged until then.",
        "roles": {
          "display": {
            "element": "h1",
            "fontSize": "3.5rem",
            "responsive": {
              "base": "2.5rem",
