  "gradient": {
    "$comment": "The signature (chapter 03, D1): Red to Sky, horizontal, sRGB, no other stop. It frames (a band, a short rule under a title, the strip on top of a card) and fills the one key figure of a page, 28 pt and up, with its left three quarters (D23, D33). Never behind body text, tables or photographs, never on the logo, icons or isometric faces, never reversed or vertical.",
    "from": "red",
    "to": "sky",
    "angle": "90deg",
    "css": "linear-gradient(90deg, #e30427, #009cfa)",
    "figure": {
      "to": "gradient-figure-end",
      "at": 0.75,
      "css": "linear-gradient(90deg, #e30427, #3976c5)"
    }
  },
  "shape": {
    "hwio": {
      "radius-selector": "2rem",
      "radius-field": "0.5rem",
      "radius-box": "1rem",
      "size-selector": "0.25rem",
      "size-field": "0.3rem",
      "border": "1px",
      "depth": "0",
      "noise": "0"
    },
    "er3o": {
      "radius-selector": "2rem",
      "radius-field": "2rem",
      "radius-box": "1.5rem",
      "size-selector": "0.25rem",
      "size-field": "0.3rem",
      "border": "1px",
      "depth": "0",
      "noise": "0"
    }
  },
