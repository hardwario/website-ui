---
import HWioSection from '@hubpav/hwio-ui/components/HWioSection.astro';
import HWioSectionHeader from '@hubpav/hwio-ui/components/HWioSectionHeader.astro';
import HWioFeatureGrid from '@hubpav/hwio-ui/components/HWioFeatureGrid.astro';
---
<HWioSection id="features" tone="alt">
  <HWioSectionHeader layout="split" eyebrow="The build-or-buy trap" title="Stop rebuilding the field layer." lead="Your value is the customer solution, not another enclosure, radio certification or fleet-management backend." />
  <HWioFeatureGrid class="mt-14" columns={3} items={[
    { icon: 'globe', title: 'Hardware slows the project', text: 'Enclosures, power, radio, compliance and supply turn a promising prototype into a long engineering program.' },
    { icon: 'bag', title: 'The stack takes over your team', text: 'Firmware updates, device operations and connectivity edge cases consume capacity meant for your application.' },
    { icon: 'check', title: 'A shortcut should not take control', text: 'Moving faster should not mean giving a vendor your customer, brand, data or product roadmap.' },
  ]} />
</HWioSection>
