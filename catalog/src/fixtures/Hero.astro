---
import HWioHeroSplit from '@hubpav/hwio-ui/components/HWioHeroSplit.astro';
---
<HWioHeroSplit
  eyebrow="For system integrators and developers"
  title="Ship industrial IoT solutions faster."
  accent="Focus on your customer, application, and roadmap."
  lead="HARDWARIO supplies the production-ready field-device foundation with open firmware tooling and documented interfaces. You keep control of the customer relationship, application, brand, data destination and roadmap."
  actions={[{ label: 'Review your project', href: '#contact', track: { id: 'hero-review', location: 'hero' } }, { label: 'Start building', href: '#developers', variant: 'secondary' }]}
  checklist={['Live data in 2–4 weeks on average for a well-scoped pilot', 'Open SDKs and your choice of data destination']}
>
  <div slot="media" class="grid aspect-[4/3] w-[88%] place-items-center rounded-box border border-base-300 bg-base-100 text-sm opacity-60">product photo (media slot)</div>
</HWioHeroSplit>
