---
import HWioHeader from '@hubpav/hwio-ui/components/HWioHeader.astro';
import HWioMegaLinks from '@hubpav/hwio-ui/components/HWioMegaLinks.astro';
// The store CTA carries the bag icon: below 2xl (the VRT's 1280 px) it collapses to the bag alone.
---
<HWioHeader
  nav={[{ label: 'Products', href: '#products', mega: 'products', children: [{ label: 'CHESTER', href: '#chester', description: 'Modular IoT gateway for industrial telemetry' }, { label: 'TOWER', href: '#tower', description: 'Modular kit for prototyping and STEM' }, { label: 'Docs', href: 'https://docs.hardwario.com/', external: true }] }, { label: 'Why TOWER', href: '#why' }, { label: 'For teachers', href: '#teachers', current: true }, { label: 'Learning paths', href: '#paths' }, { label: 'Kontakt', href: '#contact' }]}
  ctas={[{ label: 'Visit store', href: 'https://www.hardwario.store/', external: true, variant: 'secondary', icon: 'bag', track: { id: 'visit-store' } }, { label: 'Book meeting', href: '#contact', track: { id: 'goto-contact' } }]}
  languages={[{ code: 'en', label: 'English', href: '/', current: true }, { code: 'cs', label: 'Čeština', href: '/cs/' }, { code: 'de', label: 'Deutsch', href: '/de/' }, { code: 'sk', label: 'Slovenčina', href: '/sk/' }, { code: 'pl', label: 'Polski', href: '/pl/' }]}
  labels={{ nav: 'Main navigation', menu: 'Open menu', close: 'Close menu', theme: 'Switch theme', languages: 'Language' }}
>
  <a slot="logo" href="/" class="inline-flex items-center gap-2" aria-label="HARDWARIO Academy">
    <img src="/brand/hardwario-logo.svg" alt="" width="275" height="60" class="h-8 w-auto" />
  </a>
  <div slot="mega:products">
    <HWioMegaLinks title="Products" all={{ label: 'All products', href: '#products' }} columns={3} items={[
      { label: 'CHESTER', href: '#chester', description: 'Modular IoT gateway for industrial telemetry' },
      { label: 'TOWER', href: '#tower', description: 'Modular kit for prototyping and STEM' },
      { label: 'Docs', href: 'https://docs.hardwario.com/', external: true, description: 'Technical documentation' },
    ]} />
  </div>
</HWioHeader>
